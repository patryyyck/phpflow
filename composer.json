{
  "name": "phpflow/phpflow",
  "description": "Static flow analyzer for PHP applications.",
  "keywords": [
    "static-analysis",
    "symfony",
    "messenger",
    "doctrine",
    "architecture",
    "dependency-graph",
    "impact-analysis"
  ],
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "nikic/php-parser": "^5.6",
    "symfony/console": "^7.3",
    "symfony/finder": "^7.3",
    "symfony/yaml": "^7.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2"
  },
  "autoload": {
    "psr-4": {
      "PhpFlow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpFlow\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/phpflow"
  ],
  "scripts": {
    "test": "phpunit"
  }
}
