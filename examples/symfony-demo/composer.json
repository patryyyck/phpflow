{
    "name": "phpflow/symfony-demo",
    "description": "Synthetic Symfony application demonstrating PHPFlow v0.1 static-analysis patterns.",
    "type": "project",
    "license": "MIT",
    "require": {
        "doctrine/dbal": "^4.2",
        "php": "^8.4",
        "psr/cache": "^3.0",
        "symfony/cache": "^7.3",
        "symfony/dependency-injection": "^7.3",
        "symfony/filesystem": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/http-client": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/messenger": "^7.3",
        "symfony/routing": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "runtime": {
            "dotenv_path": ".env"
        }
    }
}
